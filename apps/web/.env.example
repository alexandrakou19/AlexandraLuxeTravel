# Public site URL (canonical links, sitemap, email links, CMS server URL)
NEXT_PUBLIC_SITE_URL=https://alexandraluxetravel.com

# Payload CMS
DATABASE_URI=postgresql://user:password@host/db?sslmode=require   # Neon (pooled connection string)
PAYLOAD_SECRET=                                                    # long random string: openssl rand -hex 32
BLOB_READ_WRITE_TOKEN=                                             # Vercel Blob (required on Vercel for photo uploads)

# Resend (https://resend.com): verify alexandraluxetravel.com (SPF, DKIM, DMARC) before launch.
# The inbox that receives inquiries is set in the CMS: Site Settings → Inquiries.
RESEND_API_KEY=
EMAIL_FROM="Alexandra Luxe Travel <hello@alexandraluxetravel.com>"

# Cloudflare Turnstile (optional; the check is skipped when unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_ID=

# Zapier -> TravelJoy webhook (optional; sync status is recorded on each inquiry)
ZAPIER_TRAVELJOY_HOOK_URL=

# Utah visitor alert: email that receives "visitor from Utah" alerts (disabled when unset)
GEO_ALERT_TO=
